/**app.wxss**/

/* ── 卡片基元（各页面统一引用，避免重复定义） ── */
.card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 32rpx;
  box-shadow: 0 0 12rpx rgba(0, 0, 0, 0.05);
}

/* 浅灰块（输入底 / 库存条等内嵌块） */
.block-soft {
  background: #f7f7f8;
  border-radius: 20rpx;
}

/* ── 页面/占位基元 ── */
page {
  background: #fafafa;
  color: #18181b;
  font-size: 28rpx;
  line-height: 1.4;
  -webkit-font-smoothing: antialiased;
}

button::after {
  border: none;
}

.ph {
  color: #9a9a9e;
}

/* ── 设计 token：白色表面（卡片/头部条/弹层等所有白底统一引用） ── */
page {
  --surface: #ffffff;
}
