<!--pages/index/index.wxml-->
<view class="pos-page">
  <!-- 头部 -->
  <view class="pos-head">
    <view class="head-left">
      <text class="head-sub">2026年9月8日 星期二</text>
      <text class="head-title">收银台</text>
    </view>
    <view class="head-actions">
      <view wx:if="{{ items.length > 0 }}" class="hold-btn" bindtap="holdOrder">挂单</view>
      <view class="hold-btn" bindtap="openHeld">
        取单
        <view wx:if="{{heldOrders.length > 0}}" class="hold-badge">
          {{heldOrders.length}}
        </view>
      </view>
      <view wx:if="{{ items.length > 0 }}" class="clear-btn" bindtap="clearAll">清空</view>
      <view class="scan-btn" bindtap="onScanTap">
        <t-icon name="scan" color="black" />
      </view>
    </view>
  </view>

  <!-- 商品列表（页面原生滚动，头部跟随，结算栏固定底部） -->
  <view class="body">
    <view class="body-inner">
      <view wx:for="{{items}}" wx:key="id" class="row card">
        <view class="row-info">
          <text class="row-name">{{item.name}}</text>
          <text wx:if="{{item.spec}}" class="row-spec">{{item.spec}}</text>
          <text class="row-price">¥{{item.price}}</text>
        </view>

        <view class="row-ops">
          <text class="row-del" data-idx="{{index}}" bindtap="removeItem">删除</text>
          <view class="qty-ctrl">
            <view class="qty-btn {{item.qty <= 1 ? 'disabled' : ''}}" data-idx="{{index}}" bindtap="dec">
              <t-icon name="remove" color="#111111" />
            </view>
            <input class="qty-input" type="number" value="{{item.qty}}" data-idx="{{index}}" bindinput="onQtyInput" bindblur="onQtyBlur" />
            <view class="qty-btn plus" data-idx="{{index}}" bindtap="inc">
              <t-icon name="add" color="white" />
            </view>
          </view>
        </view>
      </view>

      <view class="add-tmp" bindtap="openTmp">
        <t-icon name="add" />
        <text>添加临时商品</text>
      </view>
    </view>
  </view>

  <!-- 底部结算 -->
  <view class="bar">
    <view class="bar-info">
      <text class="bar-label">应收金额</text>
      <text class="bar-total">¥{{totalText}}</text>
    </view>
    <view class="bar-btn" bindtap="onCheckout">结算</view>
  </view>
</view>

<!-- 扫码识别结果（打样） -->
<view wx:if="{{scanResult}}" class="mask" bindtap="closeScan">
  <view class="sheet" catchtap="noop">
    <view class="scan-tip">
      <view class="ok-dot">✓</view>
      <text class="tip-title">已添加到收银台</text>
      <text class="tip-code">{{scanResult.barcode}}</text>
    </view>
    <view class="res-name">{{scanResult.name}}</view>
    <view class="res-price">¥{{scanResult.price}}</view>
    <view class="sheet-one-btn">
      <view class="btn-add wide" bindtap="rescan">再扫一件</view>
    </view>
  </view>
</view>

<!-- 统一 page-container：临时商品 / 挂单列表（一个页面只能有一个 page-container） -->
<page-container show="{{sheetShow}}" overlay="{{true}}" position="bottom" round="{{true}}" duration="{{220}}" close-on-click-overlay="{{true}}" bind:close="closeSheet">
  <!-- 临时商品录入 -->
  <view wx:if="{{sheetType === 'tmp'}}" class="pc">
    <view class="pc-bar"></view>
    <text class="pc-title">添加临时商品</text>
    <view class="tmp-field">
      <text class="tmp-label">商品名称</text>
      <input class="tmp-input" placeholder="如：定制饮品" placeholder-class="ph" value="{{tmp.name}}" bindinput="onTmpName" />
    </view>
    <view class="tmp-row">
      <view class="tmp-field half">
        <text class="tmp-label">单价（元）</text>
        <input class="tmp-input" type="digit" placeholder="0.00" value="{{tmp.price}}" bindinput="onTmpPrice" />
      </view>
      <view class="tmp-field half">
        <text class="tmp-label">数量</text>
        <input class="tmp-input" type="number" value="{{tmp.qty}}" bindinput="onTmpQty" />
      </view>
    </view>
    <view class="pc-btns">
      <view class="btn-cancel" bindtap="closeSheet">取消</view>
      <view class="btn-add" bindtap="confirmTmp">加入本单</view>
    </view>
  </view>
  <!-- 挂单列表 -->
  <view wx:elif="{{sheetType === 'held'}}" class="pc">
    <view class="pc-bar"></view>
    <text class="pc-title">挂单列表</text>
    <view wx:if="{{heldOrders.length === 0}}" class="held-empty">暂无挂单</view>
    <scroll-view wx:else scroll-y class="held-list">
      <view wx:for="{{heldOrders}}" wx:key="id" class="held-card">
        <view class="held-info" data-id="{{item.id}}" bindtap="retrieveOrder">
          <view class="held-names">{{item.items[0].name}}{{item.items.length > 1 ? ' 等' + item.items.length + '件商品' : ''}}</view>
          <view class="held-meta">
            <text>{{item.time}}</text>
            <text class="held-total">¥{{item.totalText}}</text>
          </view>
        </view>
        <view class="held-actions">
          <view class="held-take" data-id="{{item.id}}" bindtap="retrieveOrder">取单</view>
          <view class="held-del" data-id="{{item.id}}" catchtap="deleteHeldOrder">删除</view>
        </view>
      </view>
    </scroll-view>
    <view class="pc-btns">
      <view class="btn-cancel" bindtap="closeSheet">关闭</view>
    </view>
  </view>
</page-container>