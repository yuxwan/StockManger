/* pages/my/my.wxss — 我的（Tab4，参考「我的」样例稿） */
/* ── 顶部标题 ── */
.page-title {
  font-size: 40rpx;
  font-weight: 900;
  line-height: 1.2;
  color: #18181b;
}

/* ── 用户卡片（黑底白字） ── */
.user-card {
  padding: 32rpx;
  background: #18181b;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.avatar-block {
  width: 112rpx;
  height: 112rpx;
  border-radius: 28rpx;
  background: #ffffff;
  color: #18181b;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.user-info {
  flex: 1;
  min-width: 0;
}

.user-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 1.3;
}

.user-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #a1a1aa;
  line-height: 1.4;
}

.card-arrow {
  flex-shrink: 0;
}

/* ── 分组 ── */
.section {
  margin-top: 48rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #18181b;
}

/* ── 菜单卡片 ── */
.menu-card {
  margin-top: 24rpx;
  background: #ffffff;
  border-radius: 32rpx;
  overflow: hidden;
}

.menu-row {
  height: 112rpx;
  padding: 0 32rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  border-bottom: 1rpx solid #f4f4f5;
}

.menu-row:last-child {
  border-bottom: none;
}

.row-hover {
  background: #f7f7f8;
}

.row-label {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 500;
  color: #18181b;
  white-space: nowrap;
}

.row-count {
  font-size: 24rpx;
  color: #a1a1aa;
}

.row-arrow {
  flex-shrink: 0;
}

/* 打印机状态点 */
.status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #10b981;
  flex-shrink: 0;
}

/* ── 退出登录 ── */
.logout-btn {
  margin-top: 56rpx;
  height: 96rpx;
  background: #ffffff;
  color: #e11d48;
  border-radius: 32rpx;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-hover {
  background: #fdecef;
}
