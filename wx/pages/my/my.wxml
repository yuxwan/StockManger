<!--pages/my/my.wxml-->
<scroll-view scroll-y style="height: 100vh;">
  <view style="padding: 24rpx">
    <!-- 用户卡片（黑底白字，参考样例；未登录点击跳转登录页） -->
    <view class="user-card" bindtap="onUserCardTap">
      <view class="avatar-block">
        <t-icon name="user" color="#111111" size="56rpx" />
      </view>
      <view class="user-info">
        <view class="user-name">{{user.name || '未登录'}}</view>
        <view class="user-sub">{{user.sub || '点击登录账号'}}</view>
      </view>
      <t-icon class="card-arrow" name="chevron-right" color="#e4e4e7" size="38rpx" />
    </view>

    <!-- 门店管理 / 工具与设置 / 退出登录（仅登录后显示；未登录只保留顶部卡片） -->
    <view wx:if="{{loggedIn}}">
    <!-- 门店管理 -->
    <view class="section">
      <view class="section-title">门店管理</view>
      <view class="menu-card">
        <view class="menu-row" bindtap="goOrders">
          <t-icon name="order" color="#111111" size="40rpx" />
          <text class="row-label">订单记录</text>
          <text wx:if="{{orderCountText}}" class="row-count">{{orderCountText}}</text>
          <t-icon class="row-arrow" name="chevron-right" color="#c4c4c8" size="34rpx" />
        </view>
        <view class="menu-row" bindtap="goStockLog">
          <t-icon name="swap" color="#111111" size="40rpx" />
          <text class="row-label">出入库记录</text>
          <t-icon class="row-arrow" name="chevron-right" color="#c4c4c8" size="34rpx" />
        </view>
        <view class="menu-row" bindtap="comingSoon">
          <t-icon name="shop" color="#111111" size="40rpx" />
          <text class="row-label">门店与员工</text>
          <t-icon class="row-arrow" name="chevron-right" color="#c4c4c8" size="34rpx" />
        </view>
      </view>
    </view>

    <!-- 工具与设置 -->
    <view class="section">
      <view class="section-title">工具与设置</view>
      <view class="menu-card">
        <view class="menu-row" bindtap="comingSoon">
          <t-icon name="print" color="#111111" size="40rpx" />
          <text class="row-label">打印机设置</text>
          <view class="status-dot"></view>
          <t-icon class="row-arrow" name="chevron-right" color="#c4c4c8" size="34rpx" />
        </view>
        <view class="menu-row" bindtap="comingSoon">
          <t-icon name="notification" color="#111111" size="40rpx" />
          <text class="row-label">消息通知</text>
          <t-icon class="row-arrow" name="chevron-right" color="#c4c4c8" size="34rpx" />
        </view>
        <view class="menu-row" bindtap="comingSoon">
          <t-icon name="help-circle" color="#111111" size="40rpx" />
          <text class="row-label">帮助与反馈</text>
          <t-icon class="row-arrow" name="chevron-right" color="#c4c4c8" size="34rpx" />
        </view>
      </view>
    </view>

    <!-- 退出登录 -->
    <view class="logout-btn" bindtap="onLogout">退出登录</view>
    </view>
  </view>

</scroll-view>