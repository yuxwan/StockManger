.pa-page {
  /* 页面原生滚动；底部留白叠加 iPhone 安全区，避免内容被 Home 条遮挡 */
  min-height: 100vh;
}

/* OCR 文字块选择弹框 */
.ocr-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 999;
  display: flex;
  align-items: flex-end;
}

.ocr-sheet {
  width: 100%;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 32rpx calc(env(safe-area-inset-bottom) + 32rpx);
  max-height: 70vh;
  display: flex;
  flex-direction: column;
}

.ocr-title {
  font-size: 30rpx;
  color: #333;
  text-align: center;
  margin-bottom: 24rpx;
  font-weight: 600;
}

.ocr-text {
  display: flex;
  flex-wrap: wrap;
  padding: 24rpx;
  background: #f7f7f8;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
}

.ocr-char {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 60rpx;
  height: 60rpx;
  padding: 0 10rpx;
  margin: 4rpx;
  font-size: 34rpx;
  border-radius: 8rpx;
  color: #1a1a1a;
  box-sizing: border-box;
  transition: background 0.15s;
}

.ocr-char.selected {
  background: #3b82f6;
  color: #fff;
}

.ocr-break {
  width: 100%;
  height: 16rpx;
}

.ocr-actions {
  display: flex;
  gap: 16rpx;
}

.ocr-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 16rpx;
  font-size: 30rpx;
}

.ocr-btn-ghost {
  background: #f2f2f3;
  color: #666;
}

.ocr-btn-primary {
  background: #1a1a1a;
  color: #fff;
}

.group-card {
  padding: 16rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
}

/* 商品图片区 */
.img-row {
  display: flex;
  align-items: center;
  gap: 28rpx;
  padding: 24rpx 0;
}

.img-preview {
  width: 168rpx;
  height: 168rpx;
  border-radius: 24rpx;
  overflow: hidden;
  flex-shrink: 0;
  background: #f7f7f8;
}

.img-preview-img {
  width: 100%;
  height: 100%;
}

.img-empty {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.img-empty-text {
  font-size: 22rpx;
  color: #9a9a9e;
}

.img-side {
  flex: 1;
  min-width: 0;
}

.img-tip {
  font-size: 24rpx;
  color: #9a9a9e;
  line-height: 1.5;
}

.img-uploading {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #d97706;
}

.img-remove {
  margin-top: 16rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #e5484d;
}

.row {
  padding: 20rpx 0;
}

.label {
  display: block;
  font-size: 24rpx;
  color: #9a9a9e;
  margin-bottom: 12rpx;
}

.label.req::before {
  content: '* ';
  color: #ef4444;
}

.value {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.input {
  flex: 1;
  background: #f7f7f8;
  border-radius: 16rpx;
  height: 88rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.scan-mini {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  background: #111111;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* 有效期 */
.expiry-types {
  display: flex;
  gap: 12rpx;
}

.exp-chip {
  padding: 0 24rpx;
  height: 60rpx;
  line-height: 60rpx;
  border-radius: 30rpx;
  background: #f1f1f3;
  color: #6b6b70;
  font-size: 24rpx;
}

.exp-chip.on {
  background: #111111;
  color: #ffffff;
  font-weight: 600;
}

.expiry-num {
  flex-shrink: 0;
}

.pa-tip {
  margin-top: 20rpx;
  padding: 0 12rpx;
  font-size: 22rpx;
  color: #9a9a9e;
}

.pa-submit {
  height: 100rpx;
  border-radius: 50rpx;
  background: #111111;
  color: #ffffff;
  font-weight: 700;

  display: flex;
  align-items: center;
  justify-content: center;
}

.pa-submit::after {
  border: none;
}

.pa-submit.off {
  opacity: 0.5;
}

/* 删除商品（编辑模式） */
.pa-del {
  margin-top: 24rpx;
  height: 100rpx;
  border-radius: 50rpx;
  background: #ffffff;
  color: #e5484d;
  font-weight: 700;
  border: 2rpx solid #e5484d;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pa-del.off {
  opacity: 0.5;
}
